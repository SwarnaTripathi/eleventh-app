# Eleventh — Environment Variables
# Copy this to .env and fill in values before running locally.
# NEVER commit .env to git.

# ─── Demo Mode ────────────────────────────────────────────
# Set to true for local dev without real API keys.
# All Google API calls are mocked. An auto-login demo user is injected.
DEMO_MODE=true

# ─── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string-in-production

# The URL this app is served from (used for OAuth redirect URI)
APP_URL=http://localhost:8080

# ─── Google OAuth (required when DEMO_MODE=false) ─────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Gemini API (required when DEMO_MODE=false) ───────────
GEMINI_API_KEY=your-gemini-api-key

# ─── Firestore / GCP (required when DEMO_MODE=false) ──────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# If running locally with a service account key file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# (On Cloud Run, Application Default Credentials are automatic)
